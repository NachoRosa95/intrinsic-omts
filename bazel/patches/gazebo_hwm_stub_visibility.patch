# Makes Intrinsic's Gazebo hardware-module stub image visible outside
# intrinsic-core. //models/rebot_b601_rs is a simulation-only ICON hardware
# device and ships this image as its `image_sim`, like Intrinsic's own UR and
# KUKA devices. Drop this patch once intrinsic-core exposes the image.

--- a/intrinsic_control/intrinsic/icon/hardware_modules/gazebo_hwm_stub/BUILD
+++ b/intrinsic_control/intrinsic/icon/hardware_modules/gazebo_hwm_stub/BUILD
@@ -55,10 +55,7 @@
 hardware_module_image(
     name = "gazebo_hwm_stub_image",
     hardware_module_binary = "gazebo_hwm_stub_main",
-    visibility = [
-        "//intrinsic:intrinsic_internal",
-        "//intrinsic_control/intrinsic/icon:hardware_module_authors",
-    ],
+    visibility = ["//visibility:public"],
 )
 
 cc_library(
