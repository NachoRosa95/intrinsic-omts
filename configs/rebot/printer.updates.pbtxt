# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# 3D printer on the ground in front of the reBot, its open front (printer -Y)
# facing the robot (yaw -90 deg about Z), so the spool stack is on the robot's
# left (+Y). The bed centre (printer/bed_frame) lands at x=0.46, y=0,
# z=0.0895; the printer's front edge is at x=0.246. It stood 10 cm closer
# until step 3a: this far out the wrist camera can see the whole bed with
# depth from view, and the tilted grasp still reaches the bed's far half
# (offline check; about 15 cm further would lose it).
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "printer"
        }
      }
    }
    a_t_b {
      position {
        x: 0.461
        y: 0.006
        z: 0
      }
      orientation {
        x: 0
        y: 0
        z: -0.70710678
        w: 0.70710678
      }
    }
  }
}
