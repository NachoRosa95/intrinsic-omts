# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Mounts the reBot gripper on the arm's flange (link6), as in Seeed's URDF
# (joint j_gripper_end), and adds the TCP. tool_frame sits at the fingertips
# with the flange's orientation, so its +z is the approach direction.

updates: {
  update_transform {
    node_a {
      by_name {
        frame: {
          object_name: "rebot"
          frame_name: "flange"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "gripper"
        }
      }
    }
    node_to_update: {
      by_name {
        object {
          object_name: "gripper"
        }
      }
    }
    a_t_b {
      position {
        x: 0
        y: 0
        z: 0.16621
      }
      orientation {
        x: -0.70710678
        y: 0
        z: -0.70710678
        w: 0
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "tool_frame"
    parent_t_new_frame {
      position {
        x: 0
        y: 0
        z: 0
      }
      orientation {
        x: 0.70710678
        y: 0
        z: 0.70710678
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "gripper"
        }
      }
    }
  }
}

updates: {
  reparent_object: {
    object: {
      by_name: {
        object_name: "gripper"
      }
    }
    new_parent: {
      reference: {
        by_name: {
          object_name: "rebot"
        }
      }
      entity_filter: {
        include_final_entity: true
      }
    }
  }
}
