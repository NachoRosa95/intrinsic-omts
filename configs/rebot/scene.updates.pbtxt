# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Named frames for the reBot cell. demo_a and demo_b are top-down tool poses
# (tool_frame +z pointing straight down) 0.30 m in front of the base and 0.05 m
# above it, either side of center, for the step 1b motion demo.

updates {
  create_frame {
    new_frame_name: "demo_a"
    parent_t_new_frame {
      position {
        x: 0.3
        y: -0.12
        z: 0.05
      }
      orientation {
        x: 1
        y: 0
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "demo_b"
    parent_t_new_frame {
      position {
        x: 0.3
        y: 0.12
        z: 0.05
      }
      orientation {
        x: 1
        y: 0
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}
