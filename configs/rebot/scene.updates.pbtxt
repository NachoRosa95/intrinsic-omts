# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# Named frames for the reBot cell. demo_a and demo_b are top-down tool poses
# (tool_frame +z pointing straight down) 0.30 m from the base at 105 and 125
# deg from the printer's direction, on its left and clear of the printer and
# of the part at A, and 0.05 m above it, for the step 1b motion demo.

updates {
  create_frame {
    new_frame_name: "demo_a"
    parent_t_new_frame {
      position {
        x: -0.078
        y: 0.29
        z: 0.05
      }
      orientation {
        x: 1
        y: 0
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "demo_b"
    parent_t_new_frame {
      position {
        x: -0.172
        y: 0.246
        z: 0.05
      }
      orientation {
        x: 1
        y: 0
        z: 0
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

# view: the tool pose from which the wrist camera sees the bed (step 3a).
# The tool points 60 deg down into the printer with its usual roll, so the
# camera hangs below the gripper, just outside the printer's front at (0.10,
# 0, 0.255), 0.30 m from the bed centre and looking straight in. The depth
# sensor's near clip (0.25 m) and the low angle leave about three quarters of
# the bed with depth. The printer's closed top rules out looking straight
# down; most other camera poses are out of reach, need the wrist rolled over,
# or put the camera into a post (checked offline, step 3a).
updates {
  create_frame {
    new_frame_name: "view"
    parent_t_new_frame {
      position {
        x: 0.2131
        y: -0.024
        z: 0.2706
      }
      orientation {
        x: 0.866025
        y: 0
        z: 0.5
        w: 0
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

# The arm starts at "park_left" (the folded "home" turned to the robot's
# left), not at "home": folded straight ahead, the gripper reaches into the
# printer's front opening.
updates {
  update_object_joints {
    object {
      by_name {
        object_name: "rebot"
      }
    }
    joint_positions: 1.5708
    joint_positions: -0.05
    joint_positions: -0.05
    joint_positions: 0
    joint_positions: 0
    joint_positions: 0
  }
}
