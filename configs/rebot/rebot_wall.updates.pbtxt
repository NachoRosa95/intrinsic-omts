# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# A 220 x 10 x 180 mm wall standing on the ground at x=0.6, y=0, centered at
# z=0.09 so its base is on the ground. The part frames A and B are at x=0.35,
# y=-0.12 and y=0.12. Its size is set in models/rebot_wall (see README.md).
updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "rebot_wall"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "rebot_wall"
        }
      }
    }
    a_t_b {
      position {
        x: 0.35
        y: 0
        z: 0.09
      }
      orientation {
        w: 1
      }
    }
  }
}
