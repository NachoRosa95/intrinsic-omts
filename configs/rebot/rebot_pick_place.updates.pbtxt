# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# A tending round trip on opposite sides of the reBot. Source A is on the
# ground behind the robot, 0.30 m out at 145 deg from the printer's direction
# (joint1 turns only +-160 deg, so straight behind is out of reach).
# Destination B is the centre of the printer's bed in front of it
# (printer/bed_frame, x=0.36, top at z=0.0895, placed by
# printer.updates.pbtxt). The 40 x 40 x 30 mm part starts at A.
#
# The grasp is the same relative to the part at both ends, so the part is
# always set down flat: the tool is pitched 35 deg about the jaw axis (tool
# y), its approach (tool z) leaning away from the robot along the part's x
# axis. Each rest pose's x axis points away from the robot (A's is yawed
# 145 deg), so the tilt lowers the elbow at both ends; at B it keeps the
# forearm under the printer's top (z=0.45), which straight down does not. The
# fingertips (tool_frame) are 10 mm above the surface the part rests on, so
# the fingers close over its lower 20 mm. Pre-grasps back off along the
# approach axis, so the descent follows the fingers: 0.08 m at A, 0.06 m at B
# (below the printer's top). part_*_rest are the part's nominal resting poses;
# after each place, the belief world snaps the part onto the destination's
# rest frame.

updates {
  update_transform {
    node_a {
      by_name {
        object {
          object_name: "root"
        }
      }
    }
    node_b {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    node_to_update {
      by_name {
        object {
          object_name: "rebot_printed_part"
        }
      }
    }
    a_t_b {
      position {
        x: -0.245
        y: 0.17
        z: 0.015
      }
      orientation {
        x: 0
        y: 0
        z: 0.953717
        w: 0.3007058
      }
    }
  }
}

updates {
  create_frame {
    new_frame_name: "part_a_pregrasp"
    parent_t_new_frame {
      position {
        x: -0.2074
        y: 0.1437
        z: 0.0755
      }
      orientation {
        x: -0.2867882
        y: -0.909576
        z: -0.090424
        w: 0.2867882
      }
    }
    parent_object_with_filter {
      reference {
        by_name {
          object_name: "root"
        }
      }
    }
  }
}

