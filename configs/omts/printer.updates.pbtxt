# proto-file: intrinsic/world/public/proto/object_world_updates.proto
# proto-message: intrinsic_proto.world.ObjectWorldUpdates

# 3D printer on the table where the CNC enclosure used to be,
# yaw +90 deg about Z (facing the robot).
updates {
  update_transform {
    node_a { by_name { object { object_name: "enclosure" } } }
    node_b { by_name { object { object_name: "printer" } } }
    node_to_update { by_name { object { object_name: "printer" } } }
    a_t_b {
      position { x: -0.57 y: -0.10 z: 1.02 }
      orientation { x: 0 y: 0 z: 0.7071068 w: 0.7071068 }
    }
  }
}
