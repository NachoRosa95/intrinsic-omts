load("@intrinsic-core//intrinsic/scene/build_defs:sdf_scene_object.bzl", "sdf_scene_object")
load("@intrinsic-core//intrinsic_control/intrinsic/icon/hal/bzl:resources.bzl", "hardware_module_manifest")
load("@intrinsic-core//intrinsic_sdk/intrinsic/assets/hardware_devices/build_defs:hardware_device.bzl", "intrinsic_hardware_device")
load("@intrinsic-core//intrinsic_sdk/intrinsic/assets/scene_objects/build_defs:scene_object.bzl", "intrinsic_scene_object")
load("@intrinsic-core//intrinsic_sdk/intrinsic/assets/services/build_defs:services.bzl", "intrinsic_service")

package(default_visibility = ["//visibility:public"])

# Simulation-only ICON hardware device for the reBot Arm B601-RS (no gripper;
# see //models/rebot_b601_rs_gripper). In sim, Gazebo runs the hardware module
# and infers its interfaces from the arm's joints; the device ships only
# Intrinsic's Gazebo stub image. Intrinsic's real-hardware support replaces it.

# Intrinsic's stub image is visible only inside intrinsic-core;
# //bazel/patches:gazebo_hwm_stub_visibility.patch makes it public.
_GAZEBO_HWM_STUB_IMAGE = "@intrinsic-core//intrinsic_control/intrinsic/icon/hardware_modules/gazebo_hwm_stub:gazebo_hwm_stub_image.tar"

# Generated by //tools/models:urdf_to_sdf; see README.md to regenerate.
filegroup(
    name = "rebot_b601_rs_meshes",
    srcs = glob(["*.glb"]),
)

sdf_scene_object(
    name = "rebot_b601_rs_sdf_scene_object",
    src = "rebot_b601_rs.sdf",
    sdf_assets = [":rebot_b601_rs_meshes"],
    updates_pbtxts = [
        "rebot_b601_rs.named_configurations.pbtxt",
        "rebot_b601_rs_limits.updates.pbtxt",
    ],
)

intrinsic_scene_object(
    name = "rebot_b601_rs_scene_object",
    manifest = ":rebot_b601_rs_scene_object_manifest.textproto",
    scene_object = ":rebot_b601_rs_sdf_scene_object",
    visibility = ["//visibility:private"],
)

# The manifest tool also requires a real-mode image. There is no real driver
# yet, so real mode gets the stub too and the device stays simulation-only.
hardware_module_manifest(
    name = "rebot_b601_rs_service_manifest",
    image = _GAZEBO_HWM_STUB_IMAGE,
    image_sim = _GAZEBO_HWM_STUB_IMAGE,
    manifest = "rebot_b601_rs_service_manifest.textproto",
)

intrinsic_service(
    name = "rebot_b601_rs_service",
    default_config = ":rebot_b601_rs_default_config.pbtxt",
    images = [_GAZEBO_HWM_STUB_IMAGE],
    manifest = ":rebot_b601_rs_service_manifest",
    visibility = ["//visibility:private"],
    deps = [
        "@intrinsic_apis//intrinsic/assets/services/proto/v1:service_state_proto",
        "@intrinsic_apis//intrinsic/icon/hal/proto:hardware_module_config_proto",
        "@intrinsic_apis//intrinsic/icon/hardware_modules/sim_bus:sim_bus_hardware_module_proto",
    ],
)

intrinsic_hardware_device(
    name = "rebot_b601_rs",
    assets = [
        ":rebot_b601_rs_scene_object",
        ":rebot_b601_rs_service",
    ],
    manifest = "rebot_b601_rs_manifest.textproto",
)
